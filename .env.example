# Kopiere diese Datei nach .env und trage deine Daten selbst ein.
# Variante 1: Uni-Kennung und Passwort (Basic Auth)
STUDIP_USER=
STUDIP_PASSWORD=

# Variante 2: Sitzungs-Cookie aus dem Browser (Wert von "Seminar_Session")
# Wird nur genutzt, wenn Variante 1 leer ist.
STUDIP_COOKIE=

# Supabase (für den Importer). Werte unter "Connect" im Supabase-Dashboard.
# SUPABASE_KEY ist der Publishable key (sb_publishable_...), nicht der Secret key.
SUPABASE_URL=
SUPABASE_KEY=
# Dein Nutzer aus Authentication > Users
STUDHACK_EMAIL=
STUDHACK_PASSWORD=

# Claude API für generator/generate_mc.py (platform.claude.com, Settings, API Keys)
ANTHROPIC_API_KEY=
